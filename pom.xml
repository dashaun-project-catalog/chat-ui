  </parent>
  <groupId>dev.dashaun.web</groupId>
  <artifactId>chat</artifactId>
  <version>0</version>
  <name>${project.groupId}.${project.artifactId}</name>
  <properties>
    <java.version>21</java.version>
    <vaadin.version>24.3.21</vaadin.version>
